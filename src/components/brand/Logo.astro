---
interface Props {
  className?: string;
}

const { className = 'h-10' } = Astro.props;
---

<a
  href="/"
  class:list={['group inline-flex items-center gap-3 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-cyan focus-visible:ring-offset-2', className]}
  aria-label="InquisiTech home — Your Data, Decoded"
>
  <span class="flex h-10 w-10 shrink-0 transition-transform duration-300 group-hover:scale-105" aria-hidden="true">
    <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" class="h-full w-full">
      <circle cx="28" cy="28" r="20" stroke="#0284C7" stroke-width="4.5" stroke-linecap="round" stroke-dasharray="100 25" />
      <circle cx="28" cy="28" r="6" fill="#06B6D4" fill-opacity="0.2" stroke="#06B6D4" stroke-width="2" />
      <circle cx="28" cy="28" r="2" fill="#06B6D4" />
      <path d="M38 38L48 48H58" stroke="#06B6D4" stroke-width="4.5" stroke-linecap="square" stroke-linejoin="miter" />
      <circle cx="58" cy="48" r="2.5" fill="#0284C7" />
    </svg>
  </span>
  <span class="flex flex-col justify-center">
    <span class="flex items-baseline font-display text-xl leading-none tracking-tight sm:text-2xl">
      <span class="font-bold text-brand-void">Inquisi</span>
      <span class="font-medium text-brand-primary">Tech</span>
    </span>
    <span class="mt-1 text-[9px] font-sans font-semibold uppercase tracking-[0.18em] text-slate-500 sm:text-[10px]">
      Your Data, Decoded
    </span>
  </span>
</a>
