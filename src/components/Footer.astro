---
import Logo from './brand/Logo.astro';
---

<footer class="border-t border-stone-200 bg-[#f5f3ed] py-12 text-sm text-slate-600">
  <div class="mx-auto flex max-w-7xl flex-col items-center justify-between gap-6 px-4 sm:px-6 md:flex-row lg:px-8">
    <div>
      <Logo />
    </div>
    <div class="flex gap-6">
      <a href="/services/" class="transition hover:text-brand-600">Services</a>
      <a href="/blog/" class="transition hover:text-brand-600">Blog</a>
      <a href="/contact/" class="transition hover:text-brand-600">Contact</a>
    </div>
    <div class="text-xs text-slate-500">© {new Date().getFullYear()} InquisiTech. All rights reserved.</div>
  </div>
</footer>
