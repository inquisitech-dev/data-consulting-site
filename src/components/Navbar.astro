---
import Logo from './brand/Logo.astro';

const serviceLinks = [
  { name: 'Databricks Data Engineering', href: '/services/databricks-data-engineering/' },
  { name: 'Power BI Reporting', href: '/services/power-bi-reporting/' },
  { name: 'Data Analysis', href: '/services/data-analysis/' },
  { name: 'Data Platform Strategy', href: '/services/data-platform-strategy/' },
];

const navLinks = [
  { name: 'Blog', href: '/blog/' },
  { name: 'Contact', href: '/contact/' },
];
---

<header class="sticky top-0 z-50 border-b border-slate-200/80 bg-white/95 backdrop-blur-md">
  <div class="mx-auto flex h-20 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
    <Logo />

    <nav class="hidden items-center space-x-8 md:flex">
      <details class="group relative">
        <summary class="cursor-pointer list-none text-sm font-medium text-slate-700 transition-colors hover:text-brand-600">
          Services <span aria-hidden="true" class="ml-1">&#8964;</span>
        </summary>
        <div class="absolute left-0 top-full z-50 mt-3 hidden w-72 rounded-xl border border-stone-200 bg-white p-2 shadow-xl group-open:block">
          <a href="/services/" class="block rounded-md px-3 py-2 text-sm font-semibold text-slate-900 hover:bg-brand-50">All Services</a>
          {serviceLinks.map((link) => (
            <a href={link.href} class="block rounded-md px-3 py-2 text-sm text-slate-700 hover:bg-brand-50 hover:text-brand-600">{link.name}</a>
          ))}
        </div>
      </details>
      {navLinks.map((link) => (
        <a href={link.href} class="text-sm font-medium text-slate-700 transition-colors hover:text-brand-600">{link.name}</a>
      ))}
      <a href="/contact/" class="inline-flex items-center rounded-full bg-brand-500 px-5 py-2.5 text-sm font-medium text-white transition-all hover:bg-brand-600">Let’s talk</a>
    </nav>

    <div class="flex items-center gap-4 md:hidden">
      <details class="group relative">
        <summary class="cursor-pointer list-none text-sm font-medium text-slate-700 hover:text-brand-600">
          Menu <span aria-hidden="true" class="ml-1">&#8964;</span>
        </summary>
        <div class="absolute right-0 top-full z-50 mt-3 hidden w-72 max-w-[calc(100vw-2rem)] rounded-xl border border-stone-200 bg-white p-2 shadow-xl group-open:block">
          <a href="/services/" class="block rounded-md px-3 py-2 text-sm font-semibold text-slate-900 hover:bg-brand-50">All Services</a>
          {serviceLinks.map((link) => (
            <a href={link.href} class="block rounded-md px-3 py-2 text-sm text-slate-700 hover:bg-brand-50 hover:text-brand-600">{link.name}</a>
          ))}
          <a href="/blog/" class="block rounded-md px-3 py-2 text-sm text-slate-700 hover:bg-brand-50 hover:text-brand-600">Blog</a>
        </div>
      </details>
      <a href="/contact/" class="rounded-full bg-brand-500 px-3 py-1.5 text-xs font-medium text-white">Contact</a>
    </div>
  </div>
</header>
