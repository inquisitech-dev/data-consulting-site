---
const navLinks = [
  { name: 'Services', href: '/services' },
  { name: 'Blog', href: '/blog' },
  { name: 'Contact', href: '/contact' },
];
---

<header class="sticky top-0 z-50 backdrop-blur-md bg-brand-950/80 border-b border-slate-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
    <a href="/" class="flex items-center gap-2">
      <div class="w-8 h-8 rounded-lg bg-gradient-to-tr from-brand-500 to-brand-accent flex items-center justify-center font-bold text-white shadow-lg shadow-cyan-500/20">
        S
      </div>
      <span class="text-xl font-bold tracking-tight text-white">Synapse<span class="text-brand-accent">Data</span></span>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center space-x-8">
      {navLinks.map((link) => (
        <a href={link.href} class="text-sm font-medium text-slate-300 hover:text-brand-accent transition-colors">
          {link.name}
        </a>
      ))}
      <a href="/contact" class="inline-flex items-center px-4 py-2 border border-brand-500/30 rounded-lg text-sm font-medium text-white bg-brand-600/20 hover:bg-brand-600/40 hover:border-brand-500 transition-all">
        Book Architecture Review
      </a>
    </nav>

    <!-- Mobile Button -->
    <div class="md:hidden flex items-center">
      <a href="/contact" class="text-xs px-3 py-1.5 rounded-md bg-brand-600 text-white font-medium">
        Contact
      </a>
    </div>
  </div>
</header>