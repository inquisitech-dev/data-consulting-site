---
---

<section class="relative isolate overflow-hidden bg-brand-void px-4 py-16 sm:px-6 sm:py-20 lg:px-8 lg:py-24">
  <div class="pointer-events-none absolute inset-0 -z-10 bg-grid-pattern [background-size:40px_40px] opacity-50" aria-hidden="true"></div>
  <div class="pointer-events-none absolute -top-40 left-1/2 -z-10 h-[32rem] w-[50rem] -translate-x-1/2 rounded-full bg-brand-primary/20 blur-[120px]" aria-hidden="true"></div>

  <div class="mx-auto grid max-w-7xl items-center gap-14 lg:grid-cols-[1.05fr_0.95fr]">
    <div class="max-w-2xl">
      <p class="mb-6 inline-flex items-center gap-2 rounded-full border border-brand-cyan/30 bg-brand-surface/70 px-4 py-2 text-xs font-semibold uppercase tracking-[0.12em] text-cyan-100 sm:text-sm">
        <span class="h-2 w-2 rounded-full bg-brand-cyan" aria-hidden="true"></span>
        Data solutions for growing businesses
      </p>
      <h1 class="font-display text-4xl font-bold leading-[1.12] tracking-tight text-white sm:text-5xl lg:text-6xl">
        Stop running your business on <span class="text-brand-cyan">broken spreadsheets.</span>
        <span class="mt-3 block bg-gradient-to-r from-cyan-300 to-sky-400 bg-clip-text text-transparent">Get your data, decoded.</span>
      </h1>
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-slate-300 sm:text-xl">
        We connect your disjointed systems, clean your data, and build reliable <strong class="font-semibold text-white">Power BI and Tableau dashboards</strong> so your team can stop doing manual data entry and start making decisions.
      </p>
      <div class="mt-9 flex flex-col gap-3 sm:flex-row">
        <a
          href="/contact/#contact"
          class="inline-flex items-center justify-center rounded-lg bg-brand-cyan px-6 py-3.5 text-center font-semibold text-brand-void shadow-[0_0_24px_rgba(6,182,212,0.2)] transition hover:bg-cyan-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cyan-200 focus-visible:ring-offset-2 focus-visible:ring-offset-brand-void"
        >
          Book a free discovery call <span class="ml-2" aria-hidden="true">→</span>
        </a>
        <a
          href="/services/"
          class="inline-flex items-center justify-center rounded-lg border border-slate-600 bg-white/5 px-6 py-3.5 text-center font-medium text-slate-100 transition hover:border-slate-400 hover:bg-white/10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cyan-200"
        >
          See how we do it
        </a>
      </div>
      <p class="mt-5 text-sm text-slate-400">Clear advice, practical solutions, and a useful first conversation.</p>
    </div>

    <div class="relative mx-auto w-full max-w-xl" role="img" aria-label="Illustration of a business analytics dashboard">
      <div class="absolute -right-3 -top-5 z-10 rounded-full border border-brand-cyan/30 bg-brand-surface px-4 py-2 text-sm font-medium text-cyan-100 shadow-lg sm:right-2">
        One clear picture
      </div>
      <div class="rounded-2xl border border-slate-700 bg-brand-surface/95 p-4 shadow-2xl shadow-sky-950/40 sm:p-6">
        <div class="flex items-center justify-between border-b border-slate-700 pb-4">
          <div>
            <p class="text-xs font-semibold uppercase tracking-[0.16em] text-brand-cyan">Business overview</p>
            <p class="mt-1 font-display text-lg font-semibold text-white">A clearer view of your week</p>
          </div>
          <span class="rounded-full bg-emerald-400/10 px-3 py-1 text-xs font-semibold text-emerald-300">Live snapshot</span>
        </div>
        <div class="grid grid-cols-2 gap-3 py-4">
          <div class="rounded-xl border border-slate-700 bg-brand-void/70 p-4">
            <p class="text-xs text-slate-400">Monthly sales</p>
            <p class="mt-1 font-display text-2xl font-semibold text-white">$248k</p>
            <p class="mt-1 text-xs font-medium text-cyan-300">↑ 12% this month</p>
          </div>
          <div class="rounded-xl border border-slate-700 bg-brand-void/70 p-4">
            <p class="text-xs text-slate-400">Orders fulfilled</p>
            <p class="mt-1 font-display text-2xl font-semibold text-white">1,284</p>
            <p class="mt-1 text-xs font-medium text-emerald-300">On track this quarter</p>
          </div>
        </div>
        <div class="rounded-xl border border-slate-700 bg-brand-void/50 p-4">
          <div class="mb-4 flex items-center justify-between">
            <p class="text-sm font-medium text-slate-200">Sales over time</p>
            <span class="text-xs text-slate-400">Last 7 months</span>
          </div>
          <div class="flex h-32 items-end gap-2 border-b border-l border-slate-600 px-3" aria-hidden="true">
            <span class="h-[32%] flex-1 rounded-t bg-sky-800"></span>
            <span class="h-[44%] flex-1 rounded-t bg-sky-700"></span>
            <span class="h-[39%] flex-1 rounded-t bg-sky-700"></span>
            <span class="h-[62%] flex-1 rounded-t bg-sky-600"></span>
            <span class="h-[58%] flex-1 rounded-t bg-sky-600"></span>
            <span class="h-[82%] flex-1 rounded-t bg-sky-500"></span>
            <span class="h-full flex-1 rounded-t bg-brand-cyan"></span>
          </div>
          <div class="mt-2 flex justify-between px-2 text-[10px] font-medium tracking-wide text-slate-500" aria-hidden="true">
            <span>JAN</span><span>MAR</span><span>MAY</span><span>JUL</span>
          </div>
        </div>
        <div class="mt-4 flex items-center gap-3 rounded-xl border border-brand-cyan/20 bg-brand-primary/10 px-4 py-3">
          <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-brand-cyan/15 text-brand-cyan" aria-hidden="true">✦</span>
          <p class="text-sm leading-snug text-slate-300">Your team has the same numbers. <span class="font-semibold text-white">Now you can decide what to do next.</span></p>
        </div>
      </div>
      <span class="absolute -bottom-8 -left-6 -z-10 h-28 w-28 rounded-full bg-brand-cyan/15 blur-2xl" aria-hidden="true"></span>
    </div>
  </div>

  <div class="mx-auto mt-14 max-w-7xl border-t border-slate-700/80 pt-7 text-center sm:mt-16">
    <p class="text-sm text-slate-400">Enterprise-grade tools, made practical for your business:</p>
    <div class="mt-4 flex flex-wrap justify-center gap-x-8 gap-y-3 font-display text-sm font-semibold text-slate-300 sm:gap-x-12 sm:text-base">
      <span>Power BI</span><span>Tableau</span><span>dbt</span><span>Microsoft Fabric</span><span>Databricks</span>
    </div>
  </div>
</section>
