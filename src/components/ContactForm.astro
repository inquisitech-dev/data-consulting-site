---
interface Props {
  formTitle?: string;
  formSubtitle?: string;
}

const {
  formTitle = "Let's build your data foundation",
  formSubtitle = "Speak with a principal data engineer within 24 hours."
} = Astro.props;
---

<div class="rounded-2xl border border-stone-200 bg-white p-6 shadow-[0_18px_48px_-32px_rgba(38,51,43,0.3)] sm:p-8">
  <h3 class="mb-2 text-2xl font-semibold text-slate-900">{formTitle}</h3>
  <p class="mb-6 text-sm text-slate-600">{formSubtitle}</p>

  <form
    name="contact-consulting"
    method="POST"
    action="/success/"
    data-netlify="true" 
    data-netlify-honeypot="bot-field"
    class="space-y-4"
  >
    <!-- Hidden input for Netlify forms detection -->
    <input type="hidden" name="form-name" value="contact-consulting" />
    <p class="hidden">
      <label>Don’t fill this out if you're human: <input name="bot-field" /></label>
    </p>

    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
      <div>
        <label for="first_name" class="mb-1 block text-xs font-semibold uppercase tracking-wider text-slate-600">First Name *</label>
        <input required type="text" id="first_name" name="first_name" class="w-full rounded-lg border border-stone-300 bg-[#fbfaf7] px-4 py-2.5 text-slate-900 placeholder:text-slate-400 focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-100 transition-colors" placeholder="Ada" />
      </div>
      <div>
        <label for="last_name" class="mb-1 block text-xs font-semibold uppercase tracking-wider text-slate-600">Last Name</label>
        <input type="text" id="last_name" name="last_name" class="w-full rounded-lg border border-stone-300 bg-[#fbfaf7] px-4 py-2.5 text-slate-900 placeholder:text-slate-400 focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-100 transition-colors" placeholder="Lovelace" />
      </div>
    </div>

    <div>
      <label for="email" class="mb-1 block text-xs font-semibold uppercase tracking-wider text-slate-600">Work Email *</label>
      <input required type="email" id="email" name="email" class="w-full rounded-lg border border-stone-300 bg-[#fbfaf7] px-4 py-2.5 text-slate-900 placeholder:text-slate-400 focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-100 transition-colors" placeholder="ada@company.com" />
    </div>

    <div>
      <label for="service_interest" class="mb-1 block text-xs font-semibold uppercase tracking-wider text-slate-600">Primary Area of Interest</label>
      <select id="service_interest" name="service_interest" class="w-full rounded-lg border border-stone-300 bg-[#fbfaf7] px-4 py-2.5 text-slate-900 focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-100 transition-colors">
        <option value="databricks-engineering">Databricks Data Engineering</option>
        <option value="power-bi-reporting">Power BI Reporting</option>
        <option value="data-analysis">Data Analysis</option>
        <option value="platform-strategy">Data Platform Strategy</option>
      </select>
    </div>

    <div>
      <label for="message" class="mb-1 block text-xs font-semibold uppercase tracking-wider text-slate-600">Project Details / Challenges *</label>
      <textarea required id="message" name="message" rows="4" class="w-full rounded-lg border border-stone-300 bg-[#fbfaf7] px-4 py-2.5 text-slate-900 placeholder:text-slate-400 focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-100 transition-colors" placeholder="What are you hoping to make easier or clearer?"></textarea>
    </div>

    <button type="submit" class="w-full rounded-full bg-brand-500 px-6 py-3 font-semibold text-white transition-all duration-200 hover:bg-brand-600">
      Send a note
    </button>
  </form>
</div>