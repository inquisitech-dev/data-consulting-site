---
interface Props {
  formTitle?: string;
  formSubtitle?: string;
}

const {
  formTitle = "Let's untangle your data.",
  formSubtitle = "Tell us about your biggest data bottleneck. We'll schedule a 30-minute call to map out a practical next step.",
} = Astro.props;
---

<div id="contact" class="rounded-2xl border border-slate-700 bg-brand-surface p-6 shadow-2xl shadow-sky-950/20 sm:p-8">
  <div class="mb-8">
    <h2 class="font-display text-2xl font-bold text-white sm:text-3xl">{formTitle}</h2>
    <p class="mt-3 leading-relaxed text-slate-300">{formSubtitle}</p>
  </div>
  <form
    name="smb-consultation"
    method="POST"
    action="/success/"
    data-netlify="true"
    data-netlify-honeypot="bot-field"
    class="space-y-6"
  >
    <input type="hidden" name="form-name" value="smb-consultation" />
    <p class="hidden" aria-hidden="true">
      <label>Don’t fill this out: <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
    </p>

    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
      <div>
        <label for="consultation-name" class="mb-2 block text-sm font-medium text-slate-200">Name <span aria-hidden="true">*</span></label>
        <input
          id="consultation-name"
          type="text"
          name="name"
          autocomplete="name"
          required
          class="w-full rounded-lg border border-slate-600 bg-slate-950 px-4 py-3 text-slate-100 placeholder:text-slate-500 focus:border-brand-cyan focus:ring-brand-cyan"
        />
      </div>
      <div>
        <label for="consultation-email" class="mb-2 block text-sm font-medium text-slate-200">Work email <span aria-hidden="true">*</span></label>
        <input
          id="consultation-email"
          type="email"
          name="email"
          autocomplete="email"
          required
          class="w-full rounded-lg border border-slate-600 bg-slate-950 px-4 py-3 text-slate-100 placeholder:text-slate-500 focus:border-brand-cyan focus:ring-brand-cyan"
        />
      </div>
    </div>

    <div>
      <label for="consultation-challenge" class="mb-2 block text-sm font-medium text-slate-200">
        What is your biggest data challenge right now?
      </label>
      <select
        id="consultation-challenge"
        name="challenge"
        class="w-full rounded-lg border border-slate-600 bg-slate-950 px-4 py-3 text-slate-100 focus:border-brand-cyan focus:ring-brand-cyan"
      >
        <option value="manual-work">We spend too much time manually updating spreadsheets</option>
        <option value="silos">Our data is stuck in different systems (CRM, ERP, Finance)</option>
        <option value="dashboards">We need reliable automated dashboards (Power BI/Tableau)</option>
        <option value="infrastructure">We need to upgrade our backend (Data Warehouse/Lakehouse)</option>
        <option value="other">Other / Not Sure</option>
      </select>
    </div>

    <div>
      <label for="consultation-message" class="mb-2 block text-sm font-medium text-slate-200">Briefly describe your current setup</label>
      <textarea
        id="consultation-message"
        name="message"
        rows="4"
        class="w-full rounded-lg border border-slate-600 bg-slate-950 px-4 py-3 text-slate-100 placeholder:text-slate-500 focus:border-brand-cyan focus:ring-brand-cyan"
        placeholder="For example, we use Salesforce and QuickBooks, but combine exports manually every Friday..."
      ></textarea>
    </div>

    <button
      type="submit"
      class="w-full rounded-lg bg-brand-cyan px-6 py-4 text-lg font-bold text-brand-void transition hover:bg-cyan-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cyan-200 focus-visible:ring-offset-2 focus-visible:ring-offset-brand-void"
    >
      Request a consultation
    </button>
  </form>
</div>
