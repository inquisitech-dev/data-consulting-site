---
interface Props {
  formTitle?: string;
  formSubtitle?: string;
}

const { 
  formTitle = "Let's build your data foundation", 
  formSubtitle = "Speak with a principal data engineer within 24 hours." 
} = Astro.props;
---

<div class="bg-slate-900/60 p-8 rounded-2xl border border-slate-800 backdrop-blur-sm shadow-xl">
  <h3 class="text-2xl font-bold text-white mb-2">{formTitle}</h3>
  <p class="text-slate-400 text-sm mb-6">{formSubtitle}</p>

  <form 
    name="contact-consulting" 
    method="POST" 
    action="/success"
    data-netlify="true" 
    data-netlify-honeypot="bot-field"
    class="space-y-4"
  >
    <!-- Hidden input for Netlify forms detection -->
    <input type="hidden" name="form-name" value="contact-consulting" />
    <p class="hidden">
      <label>Don’t fill this out if you're human: <input name="bot-field" /></label>
    </p>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <label for="first_name" class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-1">First Name *</label>
        <input required type="text" id="first_name" name="first_name" class="w-full px-4 py-2.5 rounded-lg bg-slate-950 border border-slate-800 text-white focus:outline-none focus:border-brand-500 transition-colors" placeholder="Ada" />
      </div>
      <div>
        <label for="last_name" class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-1">Last Name</label>
        <input type="text" id="last_name" name="last_name" class="w-full px-4 py-2.5 rounded-lg bg-slate-950 border border-slate-800 text-white focus:outline-none focus:border-brand-500 transition-colors" placeholder="Lovelace" />
      </div>
    </div>

    <div>
      <label for="email" class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-1">Work Email *</label>
      <input required type="email" id="email" name="email" class="w-full px-4 py-2.5 rounded-lg bg-slate-950 border border-slate-800 text-white focus:outline-none focus:border-brand-500 transition-colors" placeholder="ada@company.com" />
    </div>

    <div>
      <label for="service_interest" class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-1">Primary Area of Interest</label>
      <select id="service_interest" name="service_interest" class="w-full px-4 py-2.5 rounded-lg bg-slate-950 border border-slate-800 text-slate-300 focus:outline-none focus:border-brand-500 transition-colors">
        <option value="data-engineering">Modern Data Lakehouse / dbt / Snowflake</option>
        <option value="bi-analytics">Power BI / Tableau Dashboards & Analytics</option>
        <option value="migration">Legacy ETL to Cloud Migration</option>
        <option value="architecture-audit">Data Quality & Pipeline Audit</option>
      </select>
    </div>

    <div>
      <label for="message" class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-1">Project Details / Challenges *</label>
      <textarea required id="message" name="message" rows="4" class="w-full px-4 py-2.5 rounded-lg bg-slate-950 border border-slate-800 text-white focus:outline-none focus:border-brand-500 transition-colors" placeholder="Describe your current tech stack, volume, and objectives..."></textarea>
    </div>

    <button type="submit" class="w-full py-3 px-6 bg-gradient-to-r from-brand-500 to-cyan-500 hover:from-brand-600 hover:to-cyan-600 text-white font-semibold rounded-lg shadow-lg shadow-cyan-500/20 transition-all duration-200">
      Request Consultation
    </button>
  </form>
</div>