---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ServiceVisualPlaceholder from '../../components/ServiceVisualPlaceholder.astro';

const services = [
  {
    title: 'Databricks Data Engineering',
    href: '/services/databricks-data-engineering/',
    description: 'Build dependable lakehouse pipelines and data products on Databricks, from ingestion through tested, production-ready transformations.',
  },
  {
    title: 'Power BI Reporting',
    href: '/services/power-bi-reporting/',
    description: 'Turn business questions into clear, governed Power BI reports backed by reusable semantic models and trusted measures.',
  },
  {
    title: 'Data Analysis',
    href: '/services/data-analysis/',
    description: 'Explore performance, define useful metrics, and surface the patterns that help teams understand what is happening and why.',
  },
  {
    title: 'Data Platform Strategy',
    href: '/services/data-platform-strategy/',
    description: 'Assess your current platform and build a pragmatic roadmap for modernization, quality, governance, and sustainable operations.',
  },
];
---

<BaseLayout title="Data Services | InquisiTech" description="Databricks data engineering, Power BI reporting, data analysis, and data platform strategy for growing businesses.">
  <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20 lg:px-8">
    <header class="max-w-3xl">
      <p class="text-sm font-semibold uppercase tracking-wider text-brand-accent">Services</p>
      <h1 class="mt-4 text-4xl font-semibold leading-tight text-slate-900 sm:text-5xl">Build a data foundation your team can trust.</h1>
      <p class="mt-6 text-lg leading-relaxed text-slate-700">
        From Databricks pipelines to decision-ready Power BI, get hands-on support to make your data more reliable, useful, and ready to scale.
      </p>
    </header>

    <div class="mt-12 grid gap-8 sm:grid-cols-2">
      {services.map((service) => (
        <article class="grid gap-6 border-t border-stone-200 pt-6 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] lg:items-center">
          <ServiceVisualPlaceholder label={service.title} />
          <div>
            <h2 class="text-2xl font-semibold text-slate-900">
              <a href={service.href} class="hover:text-brand-600">{service.title}</a>
            </h2>
            <p class="mt-3 leading-relaxed text-slate-700">{service.description}</p>
            <a href={service.href} class="mt-5 inline-flex items-center font-medium text-brand-600 hover:text-brand-accent">
              Explore service <span aria-hidden="true" class="ml-2">&rarr;</span>
            </a>
          </div>
        </article>
      ))}
    </div>

    <div class="mt-16 flex flex-col items-start justify-between gap-6 border-t border-stone-200 pt-8 sm:flex-row sm:items-center">
      <div>
        <h2 class="text-2xl font-semibold text-slate-900">Have a data challenge in mind?</h2>
        <p class="mt-2 text-slate-700">Let's talk through your goals and the next practical step.</p>
      </div>
      <a href="/contact/" class="inline-flex rounded-full bg-brand-500 px-5 py-3 font-medium text-white transition hover:bg-brand-600">Start a conversation</a>
    </div>
  </section>
</BaseLayout>