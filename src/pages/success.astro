---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Message Sent">
  <div class="max-w-xl mx-auto px-4 py-32 text-center">
    <div class="w-16 h-16 bg-brand-500/20 text-brand-accent rounded-full flex items-center justify-center mx-auto mb-6 text-2xl font-bold">
      ✓
    </div>
    <h1 class="text-3xl font-bold text-white">We've received your inquiry!</h1>
    <p class="text-slate-400 mt-4 leading-relaxed">
      A member of our engineering team will evaluate your requirements and reach out within 1 business day.
    </p>
    <a href="/" class="mt-8 inline-block px-6 py-2.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-white text-sm font-medium">
      Return Home
    </a>
  </div>
</BaseLayout>