---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Request Received | InquisiTech" description="Thank you for getting in touch with InquisiTech. We’ll follow up about your data challenge soon.">
  <div class="max-w-xl mx-auto px-4 py-32 text-center">
    <div class="mx-auto mb-6 flex h-16 w-16 items-center justify-center rounded-full bg-brand-100 text-2xl font-bold text-brand-600">
      ✓
    </div>
    <h1 class="text-3xl font-semibold text-slate-900">We've received your request!</h1>
    <p class="mt-4 leading-relaxed text-slate-700">
      A member of our team will review your data challenge and reach out within one business day.
    </p>
    <a href="/" class="mt-8 inline-block rounded-full bg-brand-500 px-6 py-2.5 text-sm font-medium text-white hover:bg-brand-600">
      Return Home
    </a>
  </div>
</BaseLayout>