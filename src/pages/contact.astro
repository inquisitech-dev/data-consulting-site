---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
---

<BaseLayout title="Contact | Synapse Data Labs" description="Discuss your data engineering, Power BI, analytics, or platform strategy needs.">
  <section class="mx-auto grid max-w-7xl gap-12 px-4 py-16 sm:px-6 sm:py-20 lg:grid-cols-2 lg:px-8">
    <div class="max-w-xl">
      <p class="text-sm font-semibold uppercase tracking-wider text-brand-accent">Contact</p>
      <h1 class="mt-4 text-4xl font-extrabold leading-tight text-white sm:text-5xl">Let's talk about your data goals.</h1>
      <p class="mt-6 text-lg leading-relaxed text-slate-300">
        Share what you're working on, where the data friction is, and what a better outcome would look like. We'll use that context to shape a useful first conversation.
      </p>
    </div>
    <ContactForm formTitle="Tell us about your project" formSubtitle="A few details will help us prepare for the conversation." />
  </section>
</BaseLayout>