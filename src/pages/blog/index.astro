---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const topics = [...new Set(posts.map((post) => post.data.topic))].sort();
const technologies = [...new Set(posts.flatMap((post) => post.data.technologies))].sort();
const coverStyles = {
  analytics: 'from-brand-200 via-[#91aa96] to-brand-600',
  engineering: 'from-brand-600 via-brand-500 to-brand-900',
  fabric: 'from-brand-500 via-[#587d69] to-brand-900',
  powerbi: 'from-[#dfad5c] via-brand-accent to-brand-900',
  strategy: 'from-brand-accent via-[#a37858] to-brand-900',
};
const coverMarks = {
  analytics: 'A',
  engineering: 'D',
  fabric: 'F',
  powerbi: 'P',
  strategy: 'S',
};
---

<BaseLayout
  title="Blog | Synapse Data Labs"
  description="Practical ideas and perspectives on data engineering, analytics, and strategy."
>
  <section class="mx-auto max-w-7xl px-4 py-14 sm:px-6 sm:py-20 lg:px-8">
    <header class="max-w-3xl">
      <p class="text-sm font-semibold uppercase tracking-[0.16em] text-brand-accent">From the team</p>
      <h1 class="mt-3 text-4xl font-semibold tracking-tight text-slate-900 sm:text-5xl">Ideas for better data decisions.</h1>
      <p class="mt-5 text-lg leading-relaxed text-slate-700">
        Clear, practical guidance on analytics, modern data platforms, and the tools that help teams do their best work.
      </p>
    </header>

    <form id="blog-filters" class="mt-10 grid gap-4 rounded-2xl border border-stone-200 bg-white p-5 shadow-sm sm:grid-cols-2 lg:grid-cols-[minmax(15rem,1.4fr)_minmax(11rem,1fr)_minmax(11rem,1fr)_auto] lg:items-end">
      <div>
        <label for="blog-search" class="mb-2 block text-sm font-medium text-slate-800">Search</label>
        <input
          id="blog-search"
          type="search"
          placeholder="Search articles..."
          class="w-full rounded-lg border border-stone-300 bg-white px-3 py-2.5 text-sm text-slate-800 placeholder:text-slate-400 focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-100"
        />
      </div>
      <div>
        <label for="blog-topic" class="mb-2 block text-sm font-medium text-slate-800">Topic</label>
        <select id="blog-topic" class="w-full rounded-lg border border-stone-300 bg-white px-3 py-2.5 text-sm text-slate-800 focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-100">
          <option value="">All topics</option>
          {topics.map((topic) => <option value={topic}>{topic}</option>)}
        </select>
      </div>
      <div>
        <label for="blog-technology" class="mb-2 block text-sm font-medium text-slate-800">Technology</label>
        <select id="blog-technology" class="w-full rounded-lg border border-stone-300 bg-white px-3 py-2.5 text-sm text-slate-800 focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-100">
          <option value="">All technologies</option>
          {technologies.map((technology) => <option value={technology}>{technology}</option>)}
        </select>
      </div>
      <button
        id="blog-reset"
        type="button"
        class="rounded-lg bg-brand-500 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-brand-600 focus:outline-none focus:ring-2 focus:ring-brand-200 focus:ring-offset-2"
      >
        Reset filters
      </button>
    </form>

    <div class="mt-7 flex items-center justify-between gap-4">
      <p id="blog-results-count" aria-live="polite" class="text-sm text-slate-600">
        {posts.length} {posts.length === 1 ? 'article' : 'articles'}
      </p>
    </div>

    {posts.length > 0 ? (
      <>
        <div id="blog-grid" class="mt-4 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {posts.map((post) => (
            <article
              data-blog-card
              data-search={`${post.data.title} ${post.data.description} ${post.data.topic} ${post.data.tags.join(' ')} ${post.data.technologies.join(' ')}`.toLocaleLowerCase()}
              data-topic={post.data.topic}
              data-technologies={post.data.technologies.join('|')}
              class="h-full"
            >
              <a
                href={`/blog/${post.slug}/`}
                class="group block h-full overflow-hidden rounded-xl border border-stone-200 bg-white shadow-sm transition hover:-translate-y-0.5 hover:border-brand-200 hover:shadow-lg focus:outline-none focus:ring-2 focus:ring-brand-500 focus:ring-offset-2"
              >
                <div class:list={['relative flex aspect-[16/10] items-end overflow-hidden bg-gradient-to-br p-5 text-white', coverStyles[post.data.cover]]} aria-hidden="true">
                  <span class="absolute -right-2 -top-12 select-none font-serif text-[11rem] font-bold leading-none text-white/15">
                    {coverMarks[post.data.cover]}
                  </span>
                  <span class="absolute -right-5 bottom-[-4.5rem] h-40 w-40 rounded-full border-[1.5rem] border-white/10"></span>
                  <span class="relative rounded-full border border-white/30 bg-white/15 px-3 py-1 text-xs font-semibold backdrop-blur-sm">
                    {post.data.technologies[0] ?? post.data.topic}
                  </span>
                </div>
                <div class="flex min-h-48 flex-col p-5">
                  <p class="text-xs font-medium text-brand-600">
                    {post.data.pubDate.toLocaleDateString('en-US', { dateStyle: 'long', timeZone: 'UTC' })}
                    <span class="mx-1.5 text-stone-300" aria-hidden="true">·</span>
                    {post.data.topic}
                  </p>
                  <h2 class="mt-2 text-lg font-semibold leading-snug text-slate-900 group-hover:text-brand-600">{post.data.title}</h2>
                  <p class="mt-2 flex-1 text-sm leading-relaxed text-slate-700">{post.data.description}</p>
                  <span class="mt-5 inline-flex items-center gap-1 text-sm font-semibold text-brand-600">
                    Read blog <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span>
                  </span>
                </div>
              </a>
            </article>
          ))}
        </div>
        <p id="blog-no-results" class="mt-10 hidden rounded-xl border border-stone-200 bg-white p-8 text-center text-slate-700">
          No articles match those filters. Try a different search or reset the filters.
        </p>
        <nav id="blog-pagination" aria-label="Blog pages" class="mt-10 flex justify-center gap-2"></nav>
      </>
    ) : (
      <p class="mt-10 text-slate-700">New articles are coming soon.</p>
    )}
  </section>
</BaseLayout>

<script>
  const form = document.querySelector<HTMLFormElement>('#blog-filters');
  const searchInput = document.querySelector<HTMLInputElement>('#blog-search');
  const topicSelect = document.querySelector<HTMLSelectElement>('#blog-topic');
  const technologySelect = document.querySelector<HTMLSelectElement>('#blog-technology');
  const resetButton = document.querySelector<HTMLButtonElement>('#blog-reset');
  const grid = document.querySelector<HTMLElement>('#blog-grid');
  const resultsCount = document.querySelector<HTMLElement>('#blog-results-count');
  const noResults = document.querySelector<HTMLElement>('#blog-no-results');
  const pagination = document.querySelector<HTMLElement>('#blog-pagination');

  if (form && searchInput && topicSelect && technologySelect && resetButton && grid && resultsCount && noResults && pagination) {
    const cards = Array.from(grid.querySelectorAll<HTMLElement>('[data-blog-card]'));
    const pageSize = 6;
    let currentPage = 1;

    function updateBlog() {
      const searchTerm = searchInput.value.trim().toLocaleLowerCase();
      const topic = topicSelect.value;
      const technology = technologySelect.value;
      const matchingCards = cards.filter((card) => {
        const matchesSearch = (card.dataset.search ?? '').includes(searchTerm);
        const matchesTopic = !topic || card.dataset.topic === topic;
        const technologies = (card.dataset.technologies ?? '').split('|');
        const matchesTechnology = !technology || technologies.includes(technology);
        return matchesSearch && matchesTopic && matchesTechnology;
      });

      const pageCount = Math.ceil(matchingCards.length / pageSize);
      currentPage = Math.min(currentPage, Math.max(pageCount, 1));
      const firstVisible = (currentPage - 1) * pageSize;
      const visibleCards = matchingCards.slice(firstVisible, firstVisible + pageSize);

      cards.forEach((card) => {
        card.hidden = !visibleCards.includes(card);
      });
      noResults.hidden = matchingCards.length > 0;
      resultsCount.textContent = matchingCards.length === 0
        ? 'No articles found'
        : `Showing ${firstVisible + 1}–${Math.min(firstVisible + pageSize, matchingCards.length)} of ${matchingCards.length} articles`;

      pagination.replaceChildren();
      if (pageCount > 1) {
        for (let page = 1; page <= pageCount; page += 1) {
          const button = document.createElement('button');
          button.type = 'button';
          button.textContent = String(page);
          button.setAttribute('aria-label', `Page ${page}`);
          if (page === currentPage) {
            button.setAttribute('aria-current', 'page');
            button.className = 'min-w-9 rounded-md bg-brand-500 px-3 py-2 text-sm font-semibold text-white';
          } else {
            button.className = 'min-w-9 rounded-md px-3 py-2 text-sm font-medium text-slate-700 transition hover:bg-brand-50 hover:text-brand-600';
          }
          button.addEventListener('click', () => {
            currentPage = page;
            updateBlog();
          });
          pagination.append(button);
        }
      }
    }

    form.addEventListener('submit', (event) => event.preventDefault());
    searchInput.addEventListener('input', () => {
      currentPage = 1;
      updateBlog();
    });
    topicSelect.addEventListener('change', () => {
      currentPage = 1;
      updateBlog();
    });
    technologySelect.addEventListener('change', () => {
      currentPage = 1;
      updateBlog();
    });
    resetButton.addEventListener('click', () => {
      form.reset();
      currentPage = 1;
      updateBlog();
    });

    updateBlog();
  }
</script>
