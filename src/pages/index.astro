---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import { getCollection } from 'astro:content';

const recentPosts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 2);

const services = [
  {
    number: '01',
    title: 'Data engineering',
    description: 'Reliable pipelines and well-organized data, built to make day-to-day work easier.',
    href: '/services/databricks-data-engineering/',
  },
  {
    number: '02',
    title: 'Power BI & reporting',
    description: 'Clear, useful dashboards that help your people see what is happening and what to do next.',
    href: '/services/power-bi-reporting/',
  },
  {
    number: '03',
    title: 'Analysis & strategy',
    description: 'A practical plan to answer your questions, improve your platform, and move forward with confidence.',
    href: '/services/data-analysis/',
  },
];
---

<BaseLayout title="Synapse Data Labs | Clearer Data. Better Decisions." description="We help growing teams make data more reliable, useful, and ready for better business decisions.">
  <section class="overflow-hidden bg-[#f5f3ed]">
    <div class="mx-auto grid max-w-7xl items-center gap-12 px-4 py-16 sm:px-6 sm:py-24 lg:grid-cols-[1.05fr_0.95fr] lg:px-8 lg:py-28">
      <div class="max-w-2xl">
        <p class="mb-5 inline-flex items-center gap-2 rounded-full border border-brand-200 bg-white/70 px-4 py-2 text-sm font-medium text-brand-600">
          <span class="h-2 w-2 rounded-full bg-brand-accent"></span>
          Your thoughtful data partner
        </p>
        <h1 class="text-4xl font-semibold leading-[1.12] tracking-tight text-slate-900 sm:text-6xl">
          Make better decisions with <span class="font-serif italic text-brand-600">data you can trust.</span>
        </h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-slate-700">
          We help teams untangle their data, get a clearer view of the business, and take the next step with confidence. Practical expertise, in plain English.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/contact/" class="inline-flex items-center rounded-full bg-brand-500 px-6 py-3 font-medium text-white shadow-sm transition hover:bg-brand-600">
            Tell us what you’re working on <span aria-hidden="true" class="ml-2">→</span>
          </a>
          <a href="/services/" class="inline-flex items-center rounded-full border border-stone-300 bg-white px-6 py-3 font-medium text-slate-800 transition hover:border-brand-500 hover:text-brand-600">
            Explore our services
          </a>
        </div>
        <p class="mt-6 text-sm text-slate-600">No jargon. No one-size-fits-all playbook. Just a useful first conversation.</p>
      </div>

      <div class="relative mx-auto w-full max-w-xl" aria-label="Illustration of a team making sense of business data">
        <div class="absolute -right-3 top-5 z-10 -rotate-3 rounded-2xl border-2 border-brand-accent bg-white px-4 py-3 font-serif text-lg italic text-slate-800 shadow-sm sm:right-0">
          “Oh, now I see it!”
        </div>
        <div class="rounded-[2rem] border border-stone-200 bg-white p-5 shadow-[0_24px_70px_-32px_rgba(38,51,43,0.28)] sm:p-8">
          <div class="flex items-center justify-between border-b border-stone-100 pb-5">
            <div>
              <p class="text-xs font-semibold uppercase tracking-[0.18em] text-brand-600">The clearer picture</p>
              <p class="mt-1 text-lg font-semibold text-slate-900">A business, at a glance</p>
            </div>
            <div class="flex gap-1.5" aria-hidden="true">
              <span class="h-2.5 w-2.5 rounded-full bg-[#e8b69b]"></span>
              <span class="h-2.5 w-2.5 rounded-full bg-[#e7d292]"></span>
              <span class="h-2.5 w-2.5 rounded-full bg-[#a8c5ae]"></span>
            </div>
          </div>
          <div class="grid grid-cols-2 gap-3 py-5">
            <div class="rounded-2xl bg-[#f5f3ed] p-4">
              <p class="text-xs text-slate-600">This month</p>
              <p class="mt-1 text-2xl font-semibold text-slate-900">$248k</p>
              <p class="mt-1 text-xs font-medium text-brand-600">↗ 12% from last month</p>
            </div>
            <div class="rounded-2xl bg-brand-50 p-4">
              <p class="text-xs text-slate-600">Orders fulfilled</p>
              <p class="mt-1 text-2xl font-semibold text-slate-900">1,284</p>
              <p class="mt-1 text-xs font-medium text-brand-600">On track this quarter</p>
            </div>
          </div>
          <div class="rounded-2xl border border-stone-100 p-4">
            <div class="mb-4 flex items-center justify-between">
              <p class="text-sm font-medium text-slate-800">A trend worth noticing</p>
              <span class="rounded-full bg-[#fbf1eb] px-2.5 py-1 text-xs font-medium text-[#9a573a]">Insight</span>
            </div>
            <div class="flex h-28 items-end gap-2 border-b border-l border-stone-200 px-3" aria-hidden="true">
              <span class="h-[32%] flex-1 rounded-t-md bg-brand-200"></span>
              <span class="h-[44%] flex-1 rounded-t-md bg-brand-200"></span>
              <span class="h-[39%] flex-1 rounded-t-md bg-brand-200"></span>
              <span class="h-[62%] flex-1 rounded-t-md bg-brand-200"></span>
              <span class="h-[58%] flex-1 rounded-t-md bg-brand-200"></span>
              <span class="h-[82%] flex-1 rounded-t-md bg-brand-500"></span>
              <span class="h-full flex-1 rounded-t-md bg-brand-500"></span>
            </div>
            <div class="mt-2 flex justify-between px-2 text-[10px] text-slate-500"><span>JAN</span><span>MAR</span><span>MAY</span><span>JUL</span></div>
          </div>
          <div class="mt-4 flex items-center gap-3 rounded-xl bg-[#f5f3ed] px-4 py-3">
            <span class="flex h-8 w-8 items-center justify-center rounded-full bg-white text-lg" aria-hidden="true">✳</span>
            <p class="text-sm leading-snug text-slate-700">The numbers make sense. <span class="font-semibold text-slate-900">What should we do next?</span></p>
          </div>
        </div>
        <span class="absolute -bottom-6 -left-5 -z-0 h-24 w-24 rounded-full bg-[#e5eadf]" aria-hidden="true"></span>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 py-20 sm:px-6 sm:py-24 lg:px-8">
    <div class="mb-10 grid gap-5 md:grid-cols-[0.8fr_1.2fr] md:items-end">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.16em] text-brand-accent">How we help</p>
        <h2 class="mt-3 text-3xl font-semibold tracking-tight text-slate-900 sm:text-4xl">Less data wrangling.<br />More forward motion.</h2>
      </div>
      <p class="max-w-2xl text-lg leading-relaxed text-slate-700">
        Good data work starts with listening. We pair senior technical know-how with a focus on the business questions your team actually needs to answer.
      </p>
    </div>

    <div class="grid gap-5 md:grid-cols-3">
      {services.map((service) => (
        <a href={service.href} class="group rounded-2xl border border-stone-200 bg-white p-7 transition hover:-translate-y-1 hover:border-brand-200 hover:shadow-lg hover:shadow-brand-900/5">
          <div class="flex items-center justify-between">
            <span class="font-serif text-2xl italic text-brand-accent">{service.number}</span>
            <span class="text-xl text-brand-500 transition group-hover:translate-x-1" aria-hidden="true">↗</span>
          </div>
          <h3 class="mt-8 text-xl font-semibold text-slate-900">{service.title}</h3>
          <p class="mt-3 leading-relaxed text-slate-700">{service.description}</p>
        </a>
      ))}
    </div>
    <div class="mt-6">
      <a href="/services/" class="font-medium text-brand-600 hover:text-brand-accent">See all our services <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section class="bg-[#edf1e9]">
    <div class="mx-auto grid max-w-7xl gap-12 px-4 py-20 sm:px-6 lg:grid-cols-2 lg:items-center lg:px-8">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.16em] text-brand-accent">Good work, together</p>
        <h2 class="mt-3 text-3xl font-semibold tracking-tight text-slate-900 sm:text-4xl">A steady hand from first question to lasting change.</h2>
        <p class="mt-5 text-lg leading-relaxed text-slate-700">We’ll meet you where you are, make the complicated feel manageable, and leave your team with something they can confidently use.</p>
      </div>
      <ol class="space-y-5">
        <li class="flex gap-4 rounded-2xl bg-white/80 p-5">
          <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-brand-100 font-semibold text-brand-600">1</span>
          <div><h3 class="font-semibold text-slate-900">Start with your goals</h3><p class="mt-1 text-sm leading-relaxed text-slate-700">We listen, ask good questions, and agree on what a useful outcome looks like.</p></div>
        </li>
        <li class="flex gap-4 rounded-2xl bg-white/80 p-5">
          <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-brand-100 font-semibold text-brand-600">2</span>
          <div><h3 class="font-semibold text-slate-900">Make a practical plan</h3><p class="mt-1 text-sm leading-relaxed text-slate-700">You get clear options and a sensible path forward—without the jargon.</p></div>
        </li>
        <li class="flex gap-4 rounded-2xl bg-white/80 p-5">
          <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-brand-100 font-semibold text-brand-600">3</span>
          <div><h3 class="font-semibold text-slate-900">Build confidence that lasts</h3><p class="mt-1 text-sm leading-relaxed text-slate-700">We deliver, explain, and help your team make the most of the result.</p></div>
        </li>
      </ol>
    </div>
  </section>

  <section class="mx-auto grid max-w-7xl gap-12 px-4 py-20 sm:px-6 lg:grid-cols-2 lg:px-8">
    <div>
      <p class="text-sm font-semibold uppercase tracking-[0.16em] text-brand-accent">Notes from the team</p>
      <h2 class="mt-3 text-3xl font-semibold tracking-tight text-slate-900">Useful ideas, clearly explained.</h2>
      <div class="mt-7 space-y-4">
        {recentPosts.map((post) => (
          <a href={`/blog/${post.slug}`} class="block rounded-2xl border border-stone-200 bg-white p-5 transition hover:border-brand-200 hover:shadow-md">
            <span class="text-xs font-medium text-brand-600">{post.data.pubDate.toLocaleDateString()}</span>
            <h3 class="mt-1 text-lg font-semibold text-slate-900">{post.data.title}</h3>
            <p class="mt-2 line-clamp-2 text-sm leading-relaxed text-slate-700">{post.data.description}</p>
          </a>
        ))}
      </div>
    </div>
    <ContactForm formTitle="Tell us what’s on your mind" formSubtitle="A little context helps us make our first conversation useful." />
  </section>
</BaseLayout>
