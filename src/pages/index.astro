---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import { getCollection } from 'astro:content';

const recentPosts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 2);
---

<BaseLayout title="Data Engineering & Analytics Consulting">
  <!-- Hero Section -->
  <section class="relative overflow-hidden py-24 sm:py-32">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(14,165,233,0.15),rgba(255,255,255,0))]"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
      <div class="max-w-3xl">
        <span class="inline-block px-3 py-1 text-xs font-semibold uppercase tracking-wider text-brand-accent bg-cyan-950/60 border border-cyan-800 rounded-full mb-6">
          High-Performance Data Infrastructure
        </span>
        <h1 class="text-4xl sm:text-6xl font-extrabold text-white tracking-tight leading-[1.1]">
          We transform messy pipelines into <span class="text-transparent bg-clip-text bg-gradient-to-r from-brand-accent to-blue-500">decision-grade data.</span>
        </h1>
        <p class="mt-6 text-lg sm:text-xl text-slate-300 leading-relaxed">
          From Snowflake and dbt architectures to C-suite Power BI dashboards, Synapse Data Labs helps enterprises clean, model, and accelerate their analytics pipelines.
        </p>
        <div class="mt-8 flex flex-wrap gap-4">
          <a href="/contact/" class="px-6 py-3 bg-brand-500 hover:bg-brand-600 text-white font-medium rounded-lg shadow-lg shadow-sky-500/25 transition-all">
            Schedule a Discovery Call
          </a>
          <a href="/services/" class="px-6 py-3 bg-slate-900 hover:bg-slate-800 text-slate-200 border border-slate-700 font-medium rounded-lg transition-all">
            View Capabilities
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Service Pillars -->
  <section class="py-20 bg-slate-800/50 border-t border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-16">
        <h2 class="text-3xl font-bold text-white">Engineering-First Analytics</h2>
        <p class="text-slate-400 mt-2">Scalable systems designed to handle petabyte-scale throughput without dashboard latency.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="p-8 rounded-2xl bg-slate-900/40 border border-slate-800/80 hover:border-slate-700 transition">
          <div class="w-12 h-12 rounded-lg bg-blue-500/10 text-brand-accent flex items-center justify-center font-bold text-xl mb-6">01</div>
          <h3 class="text-xl font-bold text-white mb-2">Modern Lakehouse Engineering</h3>
          <p class="text-slate-400 text-sm leading-relaxed">Centralize your CRM, transactional databases, and event logs into Snowflake, BigQuery, or Databricks using dbt and automated CI/CD checks.</p>
        </div>

        <div class="p-8 rounded-2xl bg-slate-900/40 border border-slate-800/80 hover:border-slate-700 transition">
          <div class="w-12 h-12 rounded-lg bg-cyan-500/10 text-cyan-400 flex items-center justify-center font-bold text-xl mb-6">02</div>
          <h3 class="text-xl font-bold text-white mb-2">Decision-Ready BI & Reporting</h3>
          <p class="text-slate-400 text-sm leading-relaxed">Fast, governed Power BI and Tableau dashboards crafted with semantic layer standards so stakeholders consistently report unified metrics.</p>
        </div>

        <div class="p-8 rounded-2xl bg-slate-900/40 border border-slate-800/80 hover:border-slate-700 transition">
          <div class="w-12 h-12 rounded-lg bg-indigo-500/10 text-indigo-400 flex items-center justify-center font-bold text-xl mb-6">03</div>
          <h3 class="text-xl font-bold text-white mb-2">Pipeline Audits & Cost Control</h3>
          <p class="text-slate-400 text-sm leading-relaxed">Identify rogue warehouse compute costs, fix failing Airflow DAGs, and introduce automated schema regression tests across mission-critical streams.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Dual Layout: Form & Insights -->
  <section class="py-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <div>
        <h2 class="text-3xl font-bold text-white mb-4">Latest Insights from the Team</h2>
        <div class="space-y-6 mt-6">
          {recentPosts.map((post) => (
            <a href={`/blog/${post.slug}`} class="block p-6 rounded-xl bg-slate-900/40 border border-slate-800 hover:border-brand-500 transition">
              <span class="text-xs text-brand-accent">{post.data.pubDate.toLocaleDateString()}</span>
              <h4 class="text-lg font-semibold text-white mt-1">{post.data.title}</h4>
              <p class="text-sm text-slate-400 mt-2 line-clamp-2">{post.data.description}</p>
            </a>
          ))}
        </div>
      </div>

      <div>
        <ContactForm />
      </div>
    </div>
  </section>
</BaseLayout>