---
import BaseLayout from './BaseLayout.astro';
const { frontmatter } = Astro.props;
---

<BaseLayout title={frontmatter.title} description={frontmatter.description}>
  <article class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <a href="/blog" class="inline-flex items-center text-sm text-brand-accent hover:underline mb-8">
      ← Back to articles
    </a>
    
    <header class="mb-10 border-b border-stone-200 pb-8">
      <div class="flex gap-2 mb-4">
        {frontmatter.tags.map((tag: string) => (
          <span class="rounded-full border border-brand-200 bg-brand-50 px-2.5 py-0.5 text-xs font-medium text-brand-600">
            {tag}
          </span>
        ))}
      </div>
      <h1 class="mb-4 text-3xl font-semibold tracking-tight text-slate-900 sm:text-5xl">{frontmatter.title}</h1>
      <p class="text-sm text-slate-600">
        Published on {new Date(frontmatter.pubDate).toLocaleDateString('en-US', { dateStyle: 'long' })} by {frontmatter.author}
      </p>
    </header>

    <div class="prose max-w-none prose-headings:text-slate-900 prose-p:text-slate-700 prose-a:text-brand-600 prose-strong:text-slate-900">
      <slot />
    </div>
  </article>
</BaseLayout>