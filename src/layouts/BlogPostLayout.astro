---
import BaseLayout from './BaseLayout.astro';
const { frontmatter } = Astro.props;
---

<BaseLayout title={frontmatter.title} description={frontmatter.description}>
  <article class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <a href="/blog" class="inline-flex items-center text-sm text-brand-accent hover:underline mb-8">
      ← Back to articles
    </a>
    
    <header class="mb-10 pb-8 border-b border-slate-800">
      <div class="flex gap-2 mb-4">
        {frontmatter.tags.map((tag: string) => (
          <span class="px-2.5 py-0.5 rounded-full text-xs font-medium bg-brand-500/10 text-brand-accent border border-brand-500/20">
            {tag}
          </span>
        ))}
      </div>
      <h1 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight mb-4">{frontmatter.title}</h1>
      <p class="text-slate-400 text-sm">
        Published on {new Date(frontmatter.pubDate).toLocaleDateString('en-US', { dateStyle: 'long' })} by {frontmatter.author}
      </p>
    </header>

    <div class="prose prose-invert prose-cyan max-w-none">
      <slot />
    </div>
  </article>
</BaseLayout>